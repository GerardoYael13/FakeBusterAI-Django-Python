# Django Configuration
# SECURITY: This key MUST be set in production. Never use the default or leave empty.
# Generate a strong key: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your-very-secret-key-here-change-this

# Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Django Debug Mode
# SECURITY WARNING: Set to False in production!
DJANGO_DEBUG=True

# Allowed Hosts
# In production, add your domain: example.com,www.example.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
